# 复制为 .env 并填入；.env 不进代码库
# 讯飞开放平台 语音评测（流式版）凭据（个人实名认证后创建应用获得）
XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# 讯飞开放平台 录音文件转写（LFASR）凭据——与上面的评测凭据是同平台两套服务，
# 在控制台「语音转写」服务页单独开通拿这三项（ADR-0004）
# 三项都非空时启用真实转写（并允许进程重启后恢复轮询）；
# 生产（NODE_ENV=production）缺这三项时上传会报「转写失败：生产环境未配置讯飞转写凭据」
# （票 13 守卫，不静默假转写）；开发/测试留空走假实现，链路仍可走通
LFASR_APP_ID=
LFASR_API_KEY=
LFASR_API_SECRET=
# 可选：=1 时先用 ffmpeg 抽 16kHz 单声道音轨再提交。LFASR 对 mp4 视频的
# 直收性待真机冒烟确认（scripts/smoke-lfasr.ts），被拒收时打开此开关；
# 需系统装有 ffmpeg（部署前置依赖里已有）
LFASR_EXTRACT_AUDIO=

# 版本选择：llm（默认，录音文件转写大模型）/ standard（录音文件转写标准版）
LFASR_MODE=

# 可选覆盖（默认 data/readalong.db 与 content/units）
DB_PATH=
CONTENT_DIR=

# 自定义内容包运行时目录（默认 data/content，按账号分子目录；部署不覆盖 data/）
CONTENT_DATA_DIR=
# 上传视频运行时目录（默认 data/uploads，按账号分子目录；部署不覆盖 data/）
UPLOADS_DIR=
# 随代码标准内容视频目录（默认 content/media；视频经 /api/media/shipped/<文件名> 鉴权提供）
SHIPPED_MEDIA_DIR=
